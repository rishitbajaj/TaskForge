# Public URL of your app (used for CORS)
CLIENT_URL=https://yourdomain.com

# Strong random secret — generate with: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret

# Host port for the web app (default 80)
HTTP_PORT=80

# Leave unset to use the bundled MongoDB container.
# For MongoDB Atlas, set this and remove the database service from docker-compose.prod.yml
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/TaskForge
